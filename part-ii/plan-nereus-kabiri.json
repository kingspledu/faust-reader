  "scenes": [
    {
      "section": "act-02-11",
      "scene_id": "source-4801",
      "description": "네레우스가 파리스에게 경고했던 트로이의 파멸을 회상한다. 현재의 동굴과 대화만 그린다."
    },
    {
      "section": "act-02-11",
      "scene_id": "source-4805",
      "description": "네레우스가 경고를 무시한 파리스의 선택을 못마땅해한다."
    },
    {
      "section": "act-02-11",
      "scene_id": "source-4809",
      "description": "네레우스가 오디세우스에게 했던 경고까지 떠올린다. 회상 속 인물을 새로 등장시키지 않는다."
    },
    {
      "section": "act-02-11",
      "scene_id": "source-4813",
      "description": "탈레스가 현자의 조언이 외면받는 고통에 공감하며 대화를 잇는다."
    },
    {
      "section": "act-02-11",
      "scene_id": "source-4819",
      "description": "탈레스가 적은 감사도 큰 위로가 된다며 다시 도움을 청한다."
    },
    {
      "section": "act-02-11",
      "scene_id": "source-4823",
      "description": "탈레스가 병 속 생명을 가리키지만 네레우스는 딸들을 기다린다고 답한다."
    },
    {
      "section": "act-02-11",
      "scene_id": "source-4829",
      "description": "네레우스가 바다의 딸들을 이야기하며 처음으로 온화한 표정을 짓는다."
    },
    {
      "section": "act-02-11",
      "scene_id": "source-4833",
      "description": "네레우스가 바다의 축제를 묘사하며 수면 쪽으로 손을 뻗는다. 딸들은 아직 등장시키지 않는다."
    },
    {
      "section": "act-02-11",
      "scene_id": "source-4837",
      "description": "네레우스가 갈라테이아의 도착을 기대하며 바다를 바라본다. 아직 갈라테이아를 그리지 않는다."
    },
    {
      "section": "act-02-11",
      "scene_id": "source-4841",
      "description": "네레우스가 탈레스에게 프로테우스를 찾아가라고 손짓한다."
    },
    {
      "section": "act-02-11",
      "scene_id": "source-4845",
      "description": "탈레스가 병을 든 채 동굴에서 돌아서며 다음 조언자를 걱정한다."
    },
    {
      "section": "act-02-11",
      "scene_id": "source-4851",
      "description": "탈레스가 길을 옮기고 멀리 바다를 보던 세이렌들이 움직임을 발견한다."
    },
    {
      "section": "act-02-11",
      "scene_id": "source-4857",
      "description": "달빛 속 바다 무리가 멀리서 다가온다. 흰 옷자락이 돛처럼 보인다."
    },
    {
      "section": "act-02-11",
      "scene_id": "source-4861",
      "description": "세이렌들이 바위에서 내려가고 네레이데스와 트리톤들이 받쳐 든 짐이 보인다."
    },
    {
      "section": "act-02-11",
      "scene_id": "source-4867",
      "description": "바다 무리가 큰 거북 껍질에 실은 작은 도기 신상 세 개를 보여 준다."
    },
    {
      "section": "act-02-11",
      "scene_id": "source-4871",
      "description": "세이렌들이 작은 신상들을 향해 노래한다. 신상은 움직이지 않는다."
    }
  ],
