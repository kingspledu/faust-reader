  "scenes": [
    {
      "section": "act-03-01",
      "scene_id": "source-5465",
      "description": "시녀들이 궁전 앞에서 헬레네의 귀환을 노래한다."
    },
    {
      "section": "act-03-01",
      "scene_id": "source-5469",
      "description": "헬레네가 궁전으로 들어간 뒤 시녀들이 문을 바라본다."
    },
    {
      "section": "act-03-01",
      "scene_id": "source-5473",
      "description": "합창단이 귀향을 기뻐한다. 신의 몸을 새로 그리지 않는다."
    },
    {
      "section": "act-03-01",
      "scene_id": "source-5477",
      "description": "시녀가 해방의 기쁨을 노래한다. 날개나 감옥을 현재에 추가하지 않는다."
    },
    {
      "section": "act-03-01",
      "scene_id": "source-5481",
      "description": "합창단이 헬레네의 귀향을 이야기한다."
    },
    {
      "section": "act-03-01",
      "scene_id": "source-5485",
      "description": "시녀들이 옛집의 문을 바라본다."
    },
    {
      "section": "act-03-01",
      "scene_id": "source-5489",
      "description": "판탈리스가 노래를 멈추라고 손짓한다."
    },
    {
      "section": "act-03-01",
      "scene_id": "source-5495",
      "description": "판탈리스가 궁전에서 급히 돌아오는 헬레네를 알아본다."
    },
    {
      "section": "act-03-01",
      "scene_id": "source-5499",
      "description": "판탈리스가 헬레네의 놀람과 분노를 보고 이유를 묻는다."
    },
    {
      "section": "act-03-02",
      "scene_id": "source-5504",
      "description": "헬레네가 평범한 두려움과 다른 공포를 설명한다."
    },
    {
      "section": "act-03-02",
      "scene_id": "source-5509",
      "description": "헬레네가 시녀들에게 겪은 일을 말한다."
    },
    {
      "section": "act-03-02",
      "scene_id": "source-5513",
      "description": "헬레네가 햇빛 아래 서서 물러서지 않겠다고 마음먹는다."
    },
    {
      "section": "act-03-02",
      "scene_id": "source-5517",
      "description": "판탈리스가 헬레네에게 자세히 말해 달라고 청한다."
    },
    {
      "section": "act-03-02",
      "scene_id": "source-5523",
      "description": "헬레네가 말로 겪은 일을 설명하기 시작한다."
    },
    {
      "section": "act-03-02",
      "scene_id": "source-5529",
      "description": "궁전의 비어 있는 내부 복도. 헬레네가 들어섰던 기억을 공간으로 보여 준다."
    },
    {
      "section": "act-03-02",
      "scene_id": "source-5533",
      "description": "기억 속 헬레네가 텅 빈 난롯가로 다가간다."
