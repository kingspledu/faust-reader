    {
      "section": "act-02-09",
      "scene_id": "source-4359",
      "description": "메피스토가 북쪽이나 이곳이나 다르지 않다며 짜증을 낸다."
    },
    {
      "section": "act-02-09",
      "scene_id": "source-4363",
      "description": "메피스토가 아름다운 가면을 잡으려다 기이한 형상을 잡았다고 되돌아본다."
    },
    {
      "section": "act-02-09",
      "scene_id": "source-4367",
      "description": "메피스토가 사라진 길과 새 바위 지형을 보고 당황한다."
    }
  ]
