      "trim_start": 0.14,
      "trim_end": 7.66,
      "effects_applied": "unknown-export-history",
      "rms_dbfs": -16.86,
      "peak_dbfs": -1.85,
      "playback_gain": 0.46989
    },
    {
      "sentence_id": "C01-P017-S01",
      "paragraph_id": "C01-P017",
      "scene_id": "c01-s015",
      "text": "문득 몸이 떨렸다.",
      "speaker": "나레이터",
      "kind": "narration",
      "voice": "Charon",
      "url": "FAUST_P1_C01_S01_0052_c01-s015_NARRATOR.mp3",
