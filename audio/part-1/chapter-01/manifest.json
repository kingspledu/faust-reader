      "playback_gain": 0.46989
    },
    {
      "sentence_id": "C01-P016-S02",
      "paragraph_id": "C01-P016",
      "scene_id": "c01-s014",
      "text": "손으로 줄을 뜯지 않아도 바람이 지날 때마다 줄이 떨리며 소리를 내는 악기였다.",
      "speaker": "나레이터",
      "kind": "narration",
      "voice": "Charon",
      "url": "FAUST_P1_C01_S01_0050_c01-s014_NARRATOR.mp3",
