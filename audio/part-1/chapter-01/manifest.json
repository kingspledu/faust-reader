    },
    {
      "sentence_id": "C01-P017-S02",
      "paragraph_id": "C01-P017",
      "scene_id": "c01-s015",
      "text": "눈물 한 방울이 뺨을 타고 내려오더니 그 뒤를 또 한 방울이 따랐다.",
      "speaker": "나레이터",
      "kind": "narration",
      "voice": "Charon",
