    },
    {
      "sentence_id": "C01-P016-S03",
      "paragraph_id": "C01-P016",
      "scene_id": "c01-s014",
      "text": "시인의 말도 일정한 가락을 찾기 전에, 기억이 닿는 곳마다 조금씩 다른 소리로 흘러나왔다.",
      "speaker": "나레이터",
      "kind": "narration",
      "voice": "Charon",
      "url": "FAUST_P1_C01_S01_0051_c01-s014_NARRATOR.mp3",
