    },
    {
      "sentence_id": "C01-P016-S01",
      "paragraph_id": "C01-P016",
      "scene_id": "c01-s014",
      "text": "그가 낮게 읊는 시는 열린 창가의 바람 하프와 닮았다.",
      "speaker": "나레이터",
      "kind": "narration",
      "voice": "Charon",
      "url": "FAUST_P1_C01_S01_0049_c01-s014_NARRATOR.mp3",
      "sha256": "ac1ed4cf9457c148c16a6c90cfa0991f2b91c42b51d71fc40160f37c1e6e5997",
      "bytes": 149838,
