      "script": [
        {
          "role": "dialogue",
          "speaker": "파우스트",
          "cast_id": "character-010",
          "text": "내가 언젠가 지금 이대로 있고 싶다고, 이 순간이 멈췄으면 좋겠다고 말하면 네가 이긴 거야."
        }
      ]
    },
    {
      "id": "c07-dense-023",
      "script": []
