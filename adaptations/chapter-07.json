        {
          "role": "dialogue",
          "speaker": "파우스트",
          "cast_id": "character-010",
          "text": "내가 어느 순간을 붙잡고 이제 그만해도 좋다고 말하면, 그때 네가 이긴 거야."
        }
      ]
