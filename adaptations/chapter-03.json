  "scenes": [
    {
      "id": "c03-dense-001",
      "script": [
        {
          "role": "narration",
          "speaker": "나레이터",
          "cast_id": "narrator",
          "text": "무대가 밝아지자 세 대천사가 저마다 세상을 바라봤다. 라파엘 앞에는 쉼 없이 돌며 빛을 보내는 해가 있었다. 가브리엘은 밤과 낮이 바뀌는 땅을, 미카엘은 바다와 육지를 가로지르는 폭풍을 보았다."
        }
      ]
    },
    {
      "id": "c03-dense-002",
      "script": []
    },
    {
      "id": "c03-dense-003",
      "script": []
    },
    {
      "id": "c03-dense-004",
      "script": [
        {
          "role": "narration",
          "speaker": "나레이터",
          "cast_id": "narrator",
          "text": "메피스토는 땅에서 보고 온 얘기를 했다. 사람들은 생각할 줄 아는 덕분에 잘 살 수도 있었지만, 그 머리를 써서 제 삶을 더 괴롭게 만들기도 했다. 메피스토는 그 점이 몹시 재미있었다."
        }
      ]
    },
    {
      "id": "c03-dense-005",
      "script": []
    },
    {
      "id": "c03-dense-006",
      "script": []
    },
    {
      "id": "c03-dense-007",
      "script": [
        {
          "role": "dialogue",
          "speaker": "주",
          "cast_id": "character-009",
          "text": "파우스트도 그렇게 보이느냐?"
        },
        {
          "role": "dialogue",
          "speaker": "메피스토",
          "cast_id": "character-008",
          "text": "그 학자 말씀이십니까? 하늘의 별까지 갖고 싶어 하면서, 여기서 누릴 수 있는 것에는 한 번을 만족 못 하더군요."
        }
      ]
    },
    {
      "id": "c03-dense-008",
      "script": []
    },
    {
      "id": "c03-dense-009",
      "script": [
        {
          "role": "dialogue",
          "speaker": "주",
          "cast_id": "character-009",
          "text": "지금은 길을 헤매고 있지. 그래도 어디로 가야 할지 찾아낼 것이다."
        }
      ]
    },
    {
      "id": "c03-dense-010",
      "script": []
    },
    {
      "id": "c03-dense-011",
      "script": [
        {
          "role": "narration",
          "speaker": "나레이터",
          "cast_id": "narrator",
          "text": "메피스토는 파우스트가 살아 있는 동안 그를 꾀어도 된다는 허락을 얻었다. 하느님이 그토록 믿는 사람이라면, 직접 엉뚱한 길을 보여 주고 어디까지 따라오는지 보고 싶었다."
        }
      ]
    },
    {
      "id": "c03-dense-012",
      "script": []
    },
    {
      "id": "c03-dense-013",
      "script": []
    },
    {
      "id": "c03-dense-014",
      "script": [
        {
          "role": "narration",
          "speaker": "나레이터",
          "cast_id": "narrator",
          "text": "다들 물러난 뒤에도 메피스토는 잠깐 남았다. 방금 자신에게 기회를 준 이가 그 기회로 무엇을 기대하는지, 그 역시 궁금했다."
        }
      ]
    }
  ]
}
