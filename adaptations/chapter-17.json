  "scenes": [
    {
      "id": "c17-dense-001",
      "script": [
        {
          "role": "narration",
          "speaker": "나레이터",
          "cast_id": "narrator",
          "text": "파우스트는 혼자 숲과 동굴을 찾아왔다. 대지의 정령에게 기도하면서 풀과 동물, 별을 바라볼 때 세상이 책 밖에서 먼저 살아 있다는 것을 느꼈다. 사람들을 피해 왔지만, 그레첸 생각까지 떨쳐 낼 수 있는 건 아니었다."
        }
      ]
    },
    {
      "id": "c17-dense-002",
      "script": []
    },
    {
      "id": "c17-dense-003",
      "script": []
    },
    {
      "id": "c17-dense-004",
      "script": []
    },
    {
      "id": "c17-dense-005",
      "script": [
        {
          "role": "narration",
          "speaker": "나레이터",
          "cast_id": "narrator",
          "text": "메피스토는 얼마 지나지 않아 동굴로 찾아왔다. 파우스트가 숲에서 마음을 가라앉히는 동안, 자신과 한 계약까지 잊어버리면 곤란했다."
        }
      ]
    },
    {
      "id": "c17-dense-006",
      "script": []
    },
    {
      "id": "c17-dense-007",
      "script": []
    },
    {
      "id": "c17-dense-008",
      "script": []
    },
    {
      "id": "c17-dense-009",
      "script": [
        {
          "role": "dialogue",
          "speaker": "파우스트",
          "cast_id": "character-010",
          "text": "여기까지 와서 꼭 그런 말만 해야겠어?"
        }
      ]
    },
    {
      "id": "c17-dense-010",
      "script": []
    },
    {
      "id": "c17-dense-011",
      "script": [
        {
          "role": "dialogue",
          "speaker": "메피스토",
          "cast_id": "character-008",
          "text": "네가 여기서 맑은 공기 마시는 동안, 걔는 집에서 네가 올지 안 올지 생각하고 있거든."
        }
      ]
    },
    {
      "id": "c17-dense-012",
      "script": []
    },
    {
      "id": "c17-dense-013",
      "script": []
    },
    {
      "id": "c17-dense-014",
      "script": [
        {
          "role": "narration",
          "speaker": "나레이터",
          "cast_id": "narrator",
          "text": "파우스트에게 그레첸을 보고 싶은 마음이 없는 것은 아니었다. 그러나 자기와 가까워질수록 그녀가 잃을 것이 많았다. 떠나면 그레첸이 혼자 아파할 것 같았고, 돌아가면 그보다 더 큰 일을 저지를까 두려웠다."
        }
      ]
    },
    {
      "id": "c17-dense-015",
      "script": []
    },
    {
      "id": "c17-dense-016",
      "script": []
    },
    {
      "id": "c17-dense-017",
      "script": [
        {
          "role": "dialogue",
          "speaker": "메피스토",
          "cast_id": "character-008",
          "text": "얼굴 한번 보여 주는 게 그렇게 어려워?"
        }
      ]
    },
    {
      "id": "c17-dense-018",
      "script": []
    },
    {
      "id": "c17-dense-019",
      "script": []
    },
    {
      "id": "c17-dense-020",
      "script": [
        {
          "role": "narration",
          "speaker": "나레이터",
          "cast_id": "narrator",
          "text": "파우스트는 자기가 감당해야 할 말을 메피스토에게 화내는 것으로 대신했다. 그래도 자리에서 일어날 때는 그레첸에게 가는 길을 이미 정해 둔 뒤였다."
        }
      ]
    },
    {
      "id": "c17-dense-021",
