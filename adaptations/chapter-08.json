        {
          "role": "dialogue",
          "speaker": "알트마이어",
          "cast_id": "character-046",
          "text": "설마 거기서 술이 나와?"
        },
        {
          "role": "dialogue",
          "speaker": "메피스토",
          "cast_id": "character-008",
          "text": "잔부터 받쳐 보세요. 옷에 묻히고 나서 후회하지 말고."
        }
