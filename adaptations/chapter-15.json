    {
      "id": "c15-dense-001",
      "script": [
        {
          "role": "narration",
          "speaker": "나레이터",
          "cast_id": "narrator",
          "text": "마르테의 정원에 네 사람이 모였다. 파우스트는 그레첸과 꽃길을 걸었고, 마르테는 뒤에서 메피스토와 걸었다. 그레첸은 배운 것이 많아 보이는 파우스트가 자기가 집에서 하는 일을 지루해할까 걱정했다."
        }
      ]
    },
    {
      "id": "c15-dense-002",
      "script": []
    },
    {
      "id": "c15-dense-003",
      "script": []
